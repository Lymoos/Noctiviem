generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String         @id @default(uuid())
  username               String         @unique
  email                  String         @unique
  passwordHash           String
  nickname               String
  avatarSeed             String         @default("")
  defaultQuality         String         @default("Auto")
  defaultAudioLang       String         @default("und")
  defaultSubsLang        String         @default("off")
  maxConcurrentDownloads Int            @default(2)
  autoSyncOnJoin         Boolean        @default(true)
  isPrivate              Boolean        @default(false)
  specialRole            String?
  avatarStyle            String         @default("thumbs")
  seatColor              String         @default("default")
  createdAt              DateTime       @default(now())

  watchHistory           WatchHistory[]
  friendsAdded           Friendship[]   @relation("FriendshipRequester")
  friendsReceived        Friendship[]   @relation("FriendshipAddressee")

  @@map("users")
}

model WatchHistory {
  id         String   @id @default(uuid())
  userId     String
  mediaTitle String
  roomName   String
  watchedAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("watch_history")
}

model Friendship {
  id           String   @id @default(uuid())
  requesterId  String
  addresseeId  String
  createdAt    DateTime @default(now())

  requester    User     @relation("FriendshipRequester",  fields: [requesterId], references: [id], onDelete: Cascade)
  addressee    User     @relation("FriendshipAddressee",  fields: [addresseeId],  references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@map("friendships")
}

model MediaItem {
  id          String   @id @default(uuid())
  title       String
  poster      String   @default("")
  thumbnail   String   @default("")
  duration    Int      @default(0)
  year        Int      @default(0)
  genre       String   @default("Downloaded")
  description String   @default("")
  audio       Json     @default("[]")
  subtitles   Json     @default("[]")
  qualities   Json     @default("[]")
  status      String   @default("processing")
  videoUrl    String
  createdAt   DateTime @default(now())

  @@map("media_items")
}

model Download {
  id            String    @id @default(uuid())
  name          String
  torrentPath   String
  infoHash      String    @default("")
  status        String    @default("queued")
  progress      Float     @default(0)
  downloaded    Float     @default(0)
  total         Float     @default(0)
  downloadSpeed Float     @default(0)
  uploadSpeed   Float     @default(0)
  numPeers      Int       @default(0)
  eta           Float     @default(0)
  files         Json      @default("[]")
  error         String?
  mediaIds      Json      @default("[]")
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@map("downloads")
}

model WatchProgress {
  id        String   @id @default(uuid())
  userId    String
  mediaId   String
  position  Float    @default(0)   // seconds into the media
  duration  Float    @default(0)   // total seconds (for % watched)
  updatedAt DateTime @updatedAt

  @@unique([userId, mediaId])
  @@index([userId])
  @@map("watch_progress")
}
