# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://noctiviem:noctiviem_dev@localhost:5432/noctiviem

# Used by docker-compose to set the postgres container password
POSTGRES_PASSWORD=noctiviem_dev

# ── Security ──────────────────────────────────────────────────────────────────
# JWT signing secret — change to a long random string in production!
JWT_SECRET=change_me_in_production_use_openssl_rand_hex_32

# ── Server ────────────────────────────────────────────────────────────────────
# Backend port (inside Docker, frontend nginx proxies to it)
PORT=3001

# Host port that the frontend (nginx) binds to
# Set to 8080 if port 80 is already in use
# FRONTEND_PORT=80

# ── Storage paths ─────────────────────────────────────────────────────────────
# Set these if running without Docker and you want custom paths
# DOWNLOADS_DIR=/data/downloads
# UPLOADS_DIR=/data/uploads
